// 頂点バッファを使わないフルスクリーン描画のVS→PS共通契約。
// FullscreenTriangle.VSはSV_VertexID 0～2からクリップ座標(-1, 1)、(3, 1)、(-1, -3)と
// UV(0, 0)、(2, 0)、(0, 2)を生成する。画面より大きい三角形を1枚使うことで、四角形を2枚の
// 三角形へ分けた際の対角線上の補間継ぎ目をなくし、頂点バッファも不要にする。
struct VSOutput
{
    // VSではクリップ座標、PSへ届く時点ではラスタライザーが生成した画素位置として扱われる。
    float4 position : SV_POSITION;
    // オーバーサイズ頂点では0～2だが、可視画面内では入力テクスチャ全域の0～1へ線形補間される。
    float2 texcoord : TEXCOORD0;
};