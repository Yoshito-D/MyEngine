  <!-- Discover and fingerprint inputs on every build, including shader-only edits.
       WriteOnlyWhenDifferent keeps timestamps stable when content is unchanged. -->
  <Target Name="PrepareShaderInputs" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ShaderSourceRoot>$([System.IO.Path]::GetFullPath('$(ShaderSourceDirectory)\'))</_ShaderSourceRoot>
      <_ShaderOutputRoot>$([System.IO.Path]::GetFullPath('$(ShaderOutputDirectory)\'))</_ShaderOutputRoot>
      <_ShaderSourceKey>$(_ShaderSourceRoot.ToUpperInvariant())</_ShaderSourceKey>
      <_ShaderOutputKey>$(_ShaderOutputRoot.ToUpperInvariant())</_ShaderOutputKey>
      <_ShaderCompiledRoot>$([System.IO.Path]::GetFullPath('$(_ShaderSourceRoot)Compiled\'))</_ShaderCompiledRoot>
      <_ShaderCompiledKey>$(_ShaderCompiledRoot.ToUpperInvariant())</_ShaderCompiledKey>
      <_ShaderCompilerDirectory>$([System.IO.Path]::GetDirectoryName('$(DxcShaderCompilerPath)'))</_ShaderCompilerDirectory>
      <_ShaderCommonState>$(_ShaderOutputRoot)shader-inputs.cache</_ShaderCommonState>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ShaderSourceRoot)')" Text="Shader source directory does not exist: $(_ShaderSourceRoot)" />
    <Error Condition="$(_ShaderSourceKey.StartsWith('$(_ShaderOutputKey)')) Or ($(_ShaderOutputKey.StartsWith('$(_ShaderSourceKey)')) And !$(_ShaderOutputKey.StartsWith('$(_ShaderCompiledKey)')))" Text="Shader output must not contain sources. Outputs inside the shader source tree must use the Compiled directory." />
    <Error Condition="!Exists('$(DxcShaderCompilerPath)')" Text="DXC was not found: $(DxcShaderCompilerPath)" />
    <ItemGroup>
      <_ShaderSource Include="$(_ShaderSourceRoot)**\*.hlsl" Exclude="$(_ShaderCompiledRoot)**\*" />
    </ItemGroup>
    <Error Condition="'@(_ShaderSource)' == ''" Text="No HLSL entry files found in $(_ShaderSourceRoot)" />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(_ShaderSource.Filename)%(_ShaderSource.Extension)', '^[A-Za-z_][A-Za-z0-9_]*\.(VS|PS|CS|GS|HS|DS)\.hlsl$'))" Text="Expected &lt;Name&gt;.&lt;VS|PS|CS|GS|HS|DS&gt;.hlsl; use .hlsli for shared code: %(_ShaderSource.FullPath)" />
    <RemoveDuplicates Inputs="@(_ShaderSource->'%(Filename)')">
      <Output TaskParameter="HadAnyDuplicates" PropertyName="_DuplicateShaderNames" />
    </RemoveDuplicates>
    <Error Condition="'$(_DuplicateShaderNames)' == 'true'" Text="Duplicate shader name and stage (case insensitive). File names must be unique across directories: @(_ShaderSource, ', ')" />
    <ItemGroup>
      <_ShaderSource>
        <Profile>$([System.IO.Path]::GetExtension('%(Filename)').Substring(1).ToLowerInvariant())_6_0</Profile>
        <OutputFile>$(_ShaderOutputRoot)%(Filename).cso</OutputFile>
        <StateFile>$(_ShaderOutputRoot)%(Filename).cso.sha256</StateFile>
      </_ShaderSource>
      <!-- Every shared include is a dependency, including nested includes. The list
           of hashes changes when an include is removed or renamed as well. -->
      <_ShaderCommonInput Include="$(MSBuildProjectFullPath);$(DxcShaderCompilerPath);$(_ShaderCompilerDirectory)\dxcompiler.dll;$(_ShaderSourceRoot)**\*.hlsli" Exclude="$(_ShaderCompiledRoot)**\*" />
      <_ShaderCommonInput Include="$(_ShaderCompilerDirectory)\dxil.dll" Condition="Exists('$(_ShaderCompilerDirectory)\dxil.dll')" />
    </ItemGroup>
    <GetFileHash Files="@(_ShaderSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_Shader" />
    </GetFileHash>
    <GetFileHash Files="@(_ShaderCommonInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ShaderCommonHash" />
    </GetFileHash>
    <MakeDir Directories="$(_ShaderOutputRoot)" />
    <WriteLinesToFile File="$(_ShaderCommonState)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="$(ShaderCompileOptions);@(_ShaderCommonHash->'%(FullPath)|%(FileHash)')" />
    <WriteLinesToFile File="%(_Shader.StateFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="%(_Shader.FullPath)|%(_Shader.Profile)|%(_Shader.FileHash)" />
  </Target>
  <!-- Target batching gives each shader its own incremental input/output check. -->
  <Target Name="CompileShaderObjects" DependsOnTargets="PrepareShaderInputs" Inputs="%(_Shader.StateFile);$(_ShaderCommonState)" Outputs="%(_Shader.OutputFile)" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="High" Text="DXC: %(_Shader.Filename)%(_Shader.Extension) -&gt; %(_Shader.OutputFile)" />
    <Delete Files="%(_Shader.OutputFile).tmp" />
    <Exec WorkingDirectory="$(ProjectDir)" UseUtf8Encoding="Always" Command="&quot;$(DxcShaderCompilerPath)&quot; &quot;%(_Shader.FullPath)&quot; $(ShaderCompileOptions) -T %(_Shader.Profile) -Fo &quot;%(_Shader.OutputFile).tmp&quot;" />
    <Error Condition="!Exists('%(_Shader.OutputFile).tmp')" Text="DXC produced no object: %(_Shader.FullPath)" />
    <!-- Publish only successful objects, retaining the last good binary on errors. -->
    <Move SourceFiles="%(_Shader.OutputFile).tmp" DestinationFiles="%(_Shader.OutputFile)" />
    <OnError ExecuteTargets="RemoveIncompleteShaderObjects" />
  </Target>
  <Target Name="RemoveIncompleteShaderObjects">
    <Delete Files="@(_Shader->'%(OutputFile).tmp')" />
  </Target>
  <Target Name="CompileShaders" BeforeTargets="PrepareForBuild" DependsOnTargets="CompileShaderObjects" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ExpectedShaderArtifact Include="@(_Shader->'%(OutputFile)');@(_Shader->'%(StateFile)')" />
      <_StaleShaderArtifact Include="$(_ShaderOutputRoot)*.cso;$(_ShaderOutputRoot)*.cso.sha256;$(_ShaderOutputRoot)*.cso.tmp" Exclude="@(_ExpectedShaderArtifact)" />
      <FileWrites Include="@(_ExpectedShaderArtifact);$(_ShaderCommonState)" />
    </ItemGroup>
    <Delete Files="@(_StaleShaderArtifact)" />
    <Message Importance="High" Text="Shaders: @(_Shader-&gt;Count()) objects available; @(_StaleShaderArtifact-&gt;Count()) stale artifacts removed." />
  </Target>
  <Target Name="PrepareTextureCache" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(ProjectDir)" Command="&quot;$(TargetPath)&quot; --prepare-textures &quot;$(ProjectDir)Resources&quot;" />
  </Target>
  <Target Name="CopyRuntimeResources" AfterTargets="PrepareTextureCache" DependsOnTargets="CompileShaders" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ResourceSourceDirectory Condition="'$(_ResourceSourceDirectory)' == ''">$(ProjectDir)Resources</_ResourceSourceDirectory>
      <_ResourceSourceRoot>$([System.IO.Path]::GetFullPath('$(_ResourceSourceDirectory)\'))</_ResourceSourceRoot>
      <_ResourceTargetRoot>$([System.IO.Path]::GetFullPath('$(TargetDir)Resources\'))</_ResourceTargetRoot>
      <_ResourceSourceKey>$(_ResourceSourceRoot.ToUpperInvariant())</_ResourceSourceKey>
      <_ResourceTargetKey>$(_ResourceTargetRoot.ToUpperInvariant())</_ResourceTargetKey>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ResourceSourceRoot)')" Text="Source Resources does not exist: $(_ResourceSourceRoot)" />
    <Error Condition="$(_ResourceSourceKey.StartsWith('$(_ResourceTargetKey)')) Or $(_ResourceTargetKey.StartsWith('$(_ResourceSourceKey)'))" Text="Runtime Resources must be separate from the source Resources folder." />
    <MakeDir Directories="$(TargetDir)" />
    <ItemGroup>
      <_OutputResourceDirectory Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)'))" />
      <_WrongCaseResourceRoot Include="@(_OutputResourceDirectory)" Condition="'%(Filename)' == 'Resources' And $([System.String]::CompareOrdinal('%(Filename)', 'Resources')) != 0" />
    </ItemGroup>
    <!-- 小文字resourcesが残っている場合だけ、管理対象のコピーを作り直して大文字へ揃える。 -->
    <RemoveDir Directories="@(_WrongCaseResourceRoot)" />
    <MakeDir Directories="$(_ResourceTargetRoot)" />
    <ItemGroup>
      <_RuntimeResourceFile Include="$(_ResourceSourceRoot)**\*" Exclude="$(_ResourceSourceRoot)engine\textures\**\*;$(_ResourceSourceRoot)game\textures\**\*;$(_ResourceSourceRoot)engine\shaders\**\*" />
      <!-- 通常テクスチャはCookedだけを含める。フォントのPNGアトラスは通常のリソースとして保持する。 -->
      <_RuntimeResourceFile Include="$(_ResourceSourceRoot)engine\textures\Cooked\*.dds;$(_ResourceSourceRoot)engine\textures\Cooked\catalog.json;$(_ResourceSourceRoot)game\textures\Cooked\*.dds;$(_ResourceSourceRoot)game\textures\Cooked\catalog.json" />
      <_ResourceToCopy Include="@(_RuntimeResourceFile)">
        <DestinationPath>$(_ResourceTargetRoot)$([MSBuild]::MakeRelative('$(_ResourceSourceRoot)', '%(FullPath)'))</DestinationPath>
      </_ResourceToCopy>
    </ItemGroup>
    <ItemGroup>
      <!-- Include generated shaders in the expected resource set so stale cleanup
           removes obsolete binaries without removing current build outputs. -->
      <_CompiledShaderFile Include="$(ShaderOutputDirectory)\*.cso" />
      <_ResourceToCopy Include="@(_CompiledShaderFile)">
        <DestinationPath>$(_ResourceTargetRoot)engine\shaders\%(Filename)%(Extension)</DestinationPath>
      </_ResourceToCopy>
    </ItemGroup>
    <Copy SourceFiles="@(_ResourceToCopy)" DestinationFiles="@(_ResourceToCopy->'%(DestinationPath)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_ExpectedRuntimeResource Include="@(_ResourceToCopy->'%(DestinationPath)')" />
      <_ExistingRuntimeResource Include="$(_ResourceTargetRoot)**\*" />
      <_StaleRuntimeResource Include="@(_ExistingRuntimeResource)" Exclude="@(_ExpectedRuntimeResource)" />
    </ItemGroup>
    <Delete Files="@(_StaleRuntimeResource)" />
    <ItemGroup>
      <_RuntimeResourceDirectory Include="$([System.IO.Directory]::GetDirectories('$(_ResourceTargetRoot)', '*', System.IO.SearchOption.AllDirectories))" />
      <_EmptyRuntimeResourceDirectory Include="@(_RuntimeResourceDirectory)" Condition="$([System.IO.Directory]::GetFiles('%(Identity)', '*', System.IO.SearchOption.AllDirectories).Length) == 0" />
    </ItemGroup>
    <RemoveDir Directories="@(_EmptyRuntimeResourceDirectory)" />
    <Message Importance="High" Text="Resources: @(_ResourceToCopy-&gt;Count()) files selected, @(_StaleRuntimeResource-&gt;Count()) stale files removed; unchanged files skipped." />
  </Target>
